<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      netstandard2.0 is not a choice. A compiler extension is loaded into the compiler's own
      process, and that process may be .NET Framework MSBuild, so RS1038 is right to insist.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>NResilience.Analyzers</RootNamespace>

    <!--
      Packed into NResilience itself rather than shipped as a package of its own: a diagnostic
      nobody installed is a diagnostic nobody gets, and the failure this catches is silent.
      IncludeBuildOutput is off because the assembly travels in analyzers/dotnet/cs, not lib/.
    -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      The analyzer release manifest is to a set of diagnostics what PublicAPI.Shipped.txt is to a
      set of members: adding, renaming or re-severity-ing a rule is a reviewed diff.
    -->
    <AnalyzerReleaseTracking>true</AnalyzerReleaseTracking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The fixes read the diagnostic properties the analyzers write. Same shipping unit, one contract. -->
    <InternalsVisibleTo Include="NResilience.CodeFixes"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>

</Project>
