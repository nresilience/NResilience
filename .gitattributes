# Auto-detect text files, normalize line endings on commit, check out as LF.
* text=auto eol=lf

# Binary files - never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.snupkg binary
*.nupkg binary
*.dll binary
*.exe binary
*.pdb binary

# Project files are always LF.
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.sln text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf