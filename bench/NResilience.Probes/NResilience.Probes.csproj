<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>NResilience.Probes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Phase 0b measures the shipping executor on Phase 0a's harness, so the arms that drive the
      gates, the trend benchmarks and the Native AOT probe all live here beside the stand-in ones
      they replaced.
    -->
    <ProjectReference Include="../../src/NResilience/NResilience.csproj" />

    <!--
      The log listener's arm. Referenced so the "a disabled level allocates nothing" gate is a
      difference against the telemetry-only arm measured in the same sweep, rather than a subtraction
      across two harnesses.
    -->
    <ProjectReference Include="../../src/NResilience.Extensions/NResilience.Extensions.csproj" />
  </ItemGroup>

</Project>
