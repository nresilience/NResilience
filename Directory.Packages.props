<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Competitive baseline. Pinned: a Polly bump must be a deliberate, re-measured change. -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />

    <!-- Trend tracking only. The hard gate below depends on no benchmark harness. -->
    <PackageVersion Include="NBenchmark" Version="0.48.1" />

    <!-- Hard gate. -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />

    <!--
      FakeLogger. The ecosystem's answer to "assert on what it logged", which is why the library
      ships no logging assertion helper of its own. Same dotnet/extensions family and version as
      TimeProvider.Testing above, decided once. Test-only, so no consumer sees it.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.9.0" />

    <!-- One version for the whole Microsoft.Extensions family, decided once. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />

    <!--
      First-party but out-of-band: it is a NuGet package rather than part of the shared
      framework, which is why it is referenced by NResilience.Extensions and never by the core
      package - "No package dependencies" is a claim core makes in its own description. The
      vocabulary the engine needs (RateLimitedException, Verdict.Limited) lives in core and costs
      nothing, so any limiter composes with the executor whether or not this package is present.
      Same version as the Microsoft.Extensions family above, decided once.
    -->
    <PackageVersion Include="System.Threading.RateLimiting" Version="10.0.11" />

    <!--
      Health checks. IHealthChecksBuilder and HealthCheckRegistration live here rather than in the
      .Abstractions package beside them, and extending the builder is the idiomatic way to register a
      check - so this is the package, not the abstractions. Its own dependencies are
      DependencyInjection.Abstractions, Options and Logging.Abstractions, all of which
      NResilience.Extensions already references. Same Microsoft.Extensions family and version as the
      rest, decided once, and already in the transitive graph of any app that calls AddHealthChecks().
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />

    <!-- The log listener's own dependency, and the one the docs snippets log through. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />

    <!--
      gRPC. Pinned in lockstep - grpc-dotnet releases its packages together and a mixed-version
      reference set is a support incident waiting to happen. Pinned rather than floated for the
      same reason Polly.Core is: NResilience.Grpc's cancellation ladder is written against
      grpc-dotnet's exception-mapping behavior, which is behavior and not contract, so a bump is a
      deliberate, re-tested change.

      Grpc.Core.Api is the interceptor base class and the call types; Grpc.Net.ClientFactory is the
      AddGrpcClient / AddInterceptor DI seam the registration extends, and brings Grpc.Net.Client
      and Microsoft.Extensions.Http transitively.
    -->
    <PackageVersion Include="Grpc.Core.Api" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.83.0" />

    <!--
      Sample-only, and on the same lockstep pin. Grpc.AspNetCore hosts the in-process gRPC service
      the sample calls; Grpc.Tools brings its own protoc, so the docs job's samples loop builds it
      with no new infrastructure. Neither is referenced by a shipping library.
    -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.83.0" />

    <!-- Declared here so the version is decided once. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />

    <!--
      The analyzers. Pinned low on purpose: an analyzer built against Roslyn 4.8 loads into every
      compiler from SDK 8.0.100 onwards, and a compiler extension that cannot load is worse than
      one that does not exist - it warns at every consumer's build and diagnoses nothing.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />

    <!--
      Source link for shipping packages. Referenced by Release.props, so every shipping library
      emits source-link metadata and a deterministic build when ContinuousIntegrationBuild is on.
    -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>

</Project>
