<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources are cleared and re-declared so a build here restores from exactly one feed,
    whatever the machine's global configuration happens to contain. Central package
    management requires it, and a competitive baseline pinned to a specific Polly build
    should not be able to resolve from an unexpected source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
