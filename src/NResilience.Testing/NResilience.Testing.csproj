<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>NResilience.Testing</RootNamespace>

    <IsShippingLibrary>true</IsShippingLibrary>

    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <PackageId>NResilience.Testing</PackageId>
    <Description>Test helpers for NResilience: a scripted callback, a recording telemetry listener, fault injection, and a deterministic simulator that measures what a policy costs a dependency over simulated minutes of a brownout.</Description>
    <PackageTags>resilience;retry;testing;simulation;polly</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- The nuget.org package page shows this package's own README, not the root one. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NResilience/NResilience.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- For Simulation.WithLimiter, which takes the platform RateLimiter the caller's own callback
         acquires from. The alternative was referencing NResilience.Extensions, where Limit lives -
         that would put DI, Options, Http, Hosting and health checks behind a test-time package for
         the sake of one abstract type that ships beside the framework. -->
    <PackageReference Include="System.Threading.RateLimiting"/>
  </ItemGroup>

  <ItemGroup>
    <!-- So the simulator's own models can be asserted on directly: Pool.At is the arithmetic that
         decides whether a modeled stall registers, and pinning it through a whole simulation run
         would be pinning the run instead. -->
    <InternalsVisibleTo Include="NResilience.Tests"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, readme. -->
  <Import Project="../../Release.props"/>

</Project>
