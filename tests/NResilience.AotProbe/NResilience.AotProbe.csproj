<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>NResilience.AotProbe</RootNamespace>

    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      The AOT gate is only a gate if a warning fails the build. TreatWarningsAsErrors covers the
      C# compiler; these three cover the trimmer, the single-file analyzer and ILCompiler, which
      report through a different channel and are silent by default.
    -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <IsTrimmable>true</IsTrimmable>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    <PackageReference Include="Microsoft.Extensions.Configuration"/>

    <!--
      The log listener's records are generated by [LoggerMessage], which is a source generator. A
      published binary is the only thing that can show the generated code both compiled and ran.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../bench/NResilience.Probes/NResilience.Probes.csproj"/>
    <ProjectReference Include="../../src/NResilience/NResilience.csproj"/>
    <ProjectReference Include="../../src/NResilience.Extensions/NResilience.Extensions.csproj"/>
    <ProjectReference Include="../../src/NResilience.Testing/NResilience.Testing.csproj"/>
  </ItemGroup>

</Project>
