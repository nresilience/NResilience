<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>NResilience.Extensions</RootNamespace>

    <IsShippingLibrary>true</IsShippingLibrary>

    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <!--
      The design's claim about ResilienceOptions is that every property on it is something the
      platform's AOT-safe binding source generator handles. The generator is what makes that
      claim testable: with it on, a reflection-based bind would raise a trim warning here, and
      warnings are errors.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <PackageId>NResilience.Extensions</PackageId>
    <Description>Dependency injection, configuration binding with hot reload, rate limiting and concurrency limiting, and OpenTelemetry-shaped metrics and traces for NResilience. Binds through a mutable DTO because the configuration binder silently ignores init-only properties.</Description>
    <PackageTags>resilience;retry;dependencyinjection;configuration;ratelimit;bulkhead;opentelemetry;polly</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- The nuget.org package page shows this package's own README, not the root one. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      RS0026 forbids overload sets that each carry an optional parameter. Every registration here
      takes an optional configure callback, which is the shape the whole ecosystem uses; the
      public API manifest is what protects source compatibility, and it is reviewed.
    -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NResilience/NResilience.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"/>
    <PackageReference Include="Microsoft.Extensions.Options"/>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions"/>
    <PackageReference Include="Microsoft.Extensions.Http"/>

    <!--
      Already in this project's transitive graph on both target frameworks by way of
      Microsoft.Extensions.Http, at the same pinned version - so the log listener costs no new
      package. Referenced directly because [LoggerMessage] lives here, and it is the only permitted
      way to write a record: the generator emits concrete code with no reflection, which is what
      keeps this project AOT clean.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>

    <!--
      The limiters themselves. Referenced here rather than in the core package because it is an
      out-of-band NuGet package; see the note in Directory.Packages.props.
    -->
    <PackageReference Include="System.Threading.RateLimiting"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NResilience.Tests"/>
    <InternalsVisibleTo Include="NResilience.IntegrationTests"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, readme. -->
  <Import Project="../../Release.props"/>

</Project>
