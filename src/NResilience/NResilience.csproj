<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>NResilience</RootNamespace>

    <!--
      Turns on the public API gate declared in Directory.Build.props. This is the first
      shipping project, so this is where PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt
      start being reviewed diffs rather than an inert idea.
    -->
    <IsShippingLibrary>true</IsShippingLibrary>

    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- The AOT claim is CI-enforced; the analyzers have to be on at the source. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>

    <PackageId>NResilience</PackageId>
    <Description>A .NET resilience library built around one flat execution engine, a declarative policy value, and defaults that are correct without configuration. Includes the HTTP integration: a delegating handler that clones the request per attempt, refuses to retry unsafe methods by default, scopes breakers and budgets per host, owns the transport timeout, and reports nested retries. No package dependencies.</Description>
    <PackageTags>resilience;retry;timeout;circuit-breaker;http;httpclient;polly</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- The nuget.org package page shows the root README. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      RS0026 forbids overload sets that each carry an optional parameter. The whole execution
      surface is exactly that on purpose - eight overloads whose last parameter is
      `CancellationToken cancellationToken = default` - because the alternative is sixteen
      overloads for one concept. The rule exists to protect source compatibility when overloads
      are added later; the public API manifest is what protects that here, and it is reviewed.
    -->
    <NoWarn>$(NoWarn);RS0026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      The analyzers and their fixes ship inside this package rather than as a package of their own.
      The failure NRES001 catches is silent - a timed-out attempt that cannot stop - and a
      diagnostic nobody installed is a diagnostic nobody gets. ReferenceOutputAssembly is off
      because the library does not use them; the ProjectReference is here for build order, and the
      DLLs travel in analyzers/dotnet/cs, which is where the compiler looks.
    -->
    <ProjectReference Include="../NResilience.Analyzers/NResilience.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../NResilience.CodeFixes/NResilience.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false"/>

    <None Include="../NResilience.Analyzers/bin/$(Configuration)/netstandard2.0/NResilience.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <None Include="../NResilience.CodeFixes/bin/$(Configuration)/netstandard2.0/NResilience.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      LatencyWindow. The adaptive concurrency limiter needs the same decaying quantile estimate
      that hedging and SlowCalls read, and the alternative was a second copy of it in a package
      that ships in lockstep with this one. The type stays internal because it is a primitive
      rather than a contract - nothing about its shape is promised to anybody outside these two
      assemblies.
    -->
    <InternalsVisibleTo Include="NResilience.Extensions"/>

    <!-- The behavioral suite constructs NextAttempt and reads the inline log directly. -->
    <InternalsVisibleTo Include="NResilience.Tests"/>
    <InternalsVisibleTo Include="NResilience.IntegrationTests"/>

    <!--
      The allocation gate asserts the inline attempt log's layout - capacity times record size -
      because the shipping executor has no log-less variant to difference against. Both are
      internal, and both are load-bearing for the suspending-path budget.
    -->
    <InternalsVisibleTo Include="NResilience.Gates"/>
  </ItemGroup>

  <!-- Shared package metadata: authors, repository URL, source link, symbols, readme. -->
  <Import Project="../../Release.props"/>

</Project>
